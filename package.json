{
  "dependencies": {
    "@types/node": "^22.13.1",
    "@yao-pkg/pkg": "^6.3.0",
    "colorts": "^0.1.63",
    "commander": "^13.1.0",
    "node-fetch": "^3.3.2",
    "yaml": "^2.7.0"
  },
  "type": "module",
  "name": "mcpm",
  "version": "0.0.1-EXPERIMENTAL",
  "description": "a Minecraft Package Manager",
  "main": "src/main.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cli": "tsx src/main.ts",
    "compile": "pkg dist/bundled/main.js -c package.json --output build/generated/mcpm",
    "bundle": "npx esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/bundled/main.js --loader:.ts=ts"
  },
  "author": "ArmanStudios",
  "license": "ISC",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.19.2"
  },
  "pkg": {
    "targets": [
      "node20-linux-x64",
      "node20-macos-x64",
      "node20-win-x64"
    ]
  }
}
